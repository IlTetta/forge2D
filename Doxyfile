PROJECT_NAME           = "forge2D"
PROJECT_BRIEF          = "Lightweight 2D game engine — C++17 / OpenGL 3.3"
PROJECT_NUMBER         = "1.0"

OUTPUT_DIRECTORY       = docs
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

INPUT                  = src
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp

EXCLUDE_PATTERNS       = */build/* */_deps/*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES

SHOW_INCLUDE_FILES     = NO
SORT_MEMBER_DOCS       = NO

QUIET                  = YES
WARNINGS               = YES

HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

HAVE_DOT               = NO
